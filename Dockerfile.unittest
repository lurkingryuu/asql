FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Build argument for parallel jobs (defaults to all available CPUs)
ARG PARALLEL_JOBS
ARG TARGETARCH
ARG LIBCEDAR_VERSION
ARG LIBCEDAR_PKG_BASE_URL=https://github.com/lurkingryuu/libcedar/releases/download
ARG LIBCEDAR_PREFIX=/opt/libcedar

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    ninja-build \
    flex \
    bison \
    pkg-config \
    doxygen \
    libkrb5-dev \
    libncurses5-dev \
    libssl-dev \
    libsasl2-dev \
    libaio-dev \
    libnuma-dev \
    libtirpc-dev \
    libldap2-dev \
    libedit-dev \
    libudev-dev \
    libcurl4-openssl-dev \
    libjsoncpp-dev \
    python3 \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install the packaged libcedar SDK from GitHub Releases.
# LIBCEDAR_CACHE_BUST can be passed from the host (e.g. as a timestamp) to
# force Docker to re-download the tarball even when all earlier layers are
# cached.  Without a declared ARG, --build-arg LIBCEDAR_CACHE_BUST=... is
# silently ignored by Docker and never invalidates this layer.
ARG LIBCEDAR_CACHE_BUST
RUN set -eux; \
    libcedar_version="${LIBCEDAR_VERSION:?LIBCEDAR_VERSION build arg must be set}"; \
    target_arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "${target_arch}" in \
      amd64) libcedar_target="x86_64-unknown-linux-gnu" ;; \
      arm64) libcedar_target="aarch64-unknown-linux-gnu" ;; \
      *) echo "Unsupported TARGETARCH: ${target_arch}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/libcedar.tar.gz \
      "${LIBCEDAR_PKG_BASE_URL}/${libcedar_version}/libcedar-${libcedar_version#v}-${libcedar_target}.tar.gz"; \
    mkdir -p "${LIBCEDAR_PREFIX}"; \
    tar -xzf /tmp/libcedar.tar.gz -C "${LIBCEDAR_PREFIX}"; \
    rm -f /tmp/libcedar.tar.gz; \
    libcedar_pc_dir=""; \
    for candidate in "${LIBCEDAR_PREFIX}/lib/pkgconfig" "${LIBCEDAR_PREFIX}"/lib/*/pkgconfig; do \
      if [ -f "${candidate}/libcedar.pc" ]; then libcedar_pc_dir="${candidate}"; break; fi; \
    done; \
    test -n "${libcedar_pc_dir}"; \
    ln -sfn "${libcedar_pc_dir}" "${LIBCEDAR_PREFIX}/lib/pkgconfig"

ENV PKG_CONFIG_PATH="${LIBCEDAR_PREFIX}/lib/pkgconfig"
ENV CMAKE_PREFIX_PATH="${LIBCEDAR_PREFIX}"

RUN mkdir -p /tmp/boost /mysql-build

# Pre-download Boost to avoid timeout issues during cmake
RUN wget -q -O /tmp/boost.tar.bz2 https://archives.boost.io/release/1.77.0/source/boost_1_77_0.tar.bz2 && \
    tar -xjf /tmp/boost.tar.bz2 -C /tmp/boost --strip-components=1

WORKDIR /mysql-source

# Copy necessary files for build
COPY CMakeLists.txt MYSQL_VERSION *.cmake *.in *.h.cmake README INSTALL LICENSE ./
COPY *.sh ./
COPY sql/ sql/
COPY include/ include/
COPY storage/ storage/
COPY cmake/ cmake/
COPY libmysql/ libmysql/
COPY mysys/ mysys/
COPY extra/ extra/
COPY strings/ strings/
COPY vio/ vio/
COPY components/ components/
COPY plugin/ plugin/
COPY share/ share/
COPY libservices/ libservices/
COPY libbinlogevents/ libbinlogevents/
COPY libbinlogstandalone/ libbinlogstandalone/
COPY libchangestreams/ libchangestreams/
COPY sql-common/ sql-common/
COPY utilities/ utilities/
COPY client/ client/
COPY router/ router/
COPY packaging/ packaging/
COPY man/ man/
COPY support-files/ support-files/
COPY testclients/ testclients/
COPY scripts/ scripts/
COPY mysql-test/ mysql-test/
COPY unittest/ unittest/
COPY doxygen_resources/ doxygen_resources/

# Re-copy the auth/plugin sources we iterate on most often so the unittest image
# always reflects the latest versions even if a broader directory copy is stale.
COPY plugin/authorization/authorization_common.cc plugin/authorization/authorization_common.cc
COPY plugin/authorization/cedar_authorization.cc plugin/authorization/cedar_authorization.cc
COPY plugin/authorization/embedded_cedar.cc plugin/authorization/embedded_cedar.cc
COPY plugin/authorization/embedded_cedar.h plugin/authorization/embedded_cedar.h
COPY plugin/authorization/CMakeLists.txt plugin/authorization/CMakeLists.txt
COPY plugin/authorization/testdata/embedded_cedar/schema.json plugin/authorization/testdata/embedded_cedar/schema.json
COPY unittest/gunit/authorization/CMakeLists.txt unittest/gunit/authorization/CMakeLists.txt
COPY unittest/gunit/authorization/authorization-t.cc unittest/gunit/authorization/authorization-t.cc
COPY unittest/gunit/authorization/embedded-cedar-t.cc unittest/gunit/authorization/embedded-cedar-t.cc

WORKDIR /mysql-build

# Configure for unittests
# Use RelWithDebInfo to reduce build artifacts size (Debug is too huge for some Docker environments)
RUN cmake /mysql-source \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/usr/local/mysql \
    -DDOWNLOAD_BOOST=0 \
    -DWITH_BOOST=/tmp/boost \
    -DWITH_UNIT_TESTS=ON \
    -DWITH_DEBUG=OFF \
    -DENABLED_LOCAL_INFILE=1 \
    -DMYSQL_DATADIR=/var/lib/mysql \
    -DSYSCONFDIR=/etc/mysql \
    -DWITH_SSL=system \
    -G Ninja

# Build the server, plugins, and focused test binaries needed by the unified
# authorization test runner. Avoid the default `all` target to keep image size
# and build time manageable.
RUN if [ -n "${PARALLEL_JOBS}" ]; then \
        ninja -j${PARALLEL_JOBS} mysqld mysql ddl_audit embedded_cedar authorization-t embedded-cedar-t; \
    else \
        ninja -j$(nproc) mysqld mysql ddl_audit embedded_cedar authorization-t embedded-cedar-t; \
    fi

RUN chmod +x \
    /mysql-source/unittest/docker/run-test-suite.sh \
    /mysql-source/test_integrated_plugins.sh \
    /mysql-source/unittest/docker/mock_cedar_sync_service.py

WORKDIR /mysql-build

ENTRYPOINT ["/mysql-source/unittest/docker/run-test-suite.sh"]
CMD ["full"]
