# syntax=docker/dockerfile:1.7-labs

FROM ubuntu:22.04 AS toolchain

ENV DEBIAN_FRONTEND=noninteractive
ARG LIBCEDAR_PREFIX=/opt/libcedar

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y \
    build-essential \
    ccache \
    cmake \
    git \
    ninja-build \
    flex \
    bison \
    pkg-config \
    doxygen \
    libkrb5-dev \
    libncurses5-dev \
    libssl-dev \
    libsasl2-dev \
    libaio-dev \
    libnuma-dev \
    libtirpc-dev \
    libldap2-dev \
    libedit-dev \
    libudev-dev \
    libcurl4-openssl-dev \
    libjsoncpp-dev \
    python3 \
    rsync \
    curl \
    && rm -rf /var/lib/apt/lists/*

FROM toolchain AS boost

ARG BOOST_VERSION=1.77.0
ARG BOOST_PACKAGE_NAME=boost_1_77_0

RUN mkdir -p /tmp/boost

# Pre-download Boost to avoid timeout issues during cmake.
RUN --mount=type=cache,target=/var/cache/asql-downloads/boost \
    set -eux; \
    boost_archive="/var/cache/asql-downloads/boost/${BOOST_PACKAGE_NAME}.tar.gz"; \
    if [ ! -s "${boost_archive}" ]; then \
      rm -f "${boost_archive}"; \
      for boost_url in \
        "https://github.com/boostorg/boost/releases/download/boost-${BOOST_VERSION}/${BOOST_PACKAGE_NAME}.tar.gz" \
        "https://archives.boost.io/release/${BOOST_VERSION}/source/${BOOST_PACKAGE_NAME}.tar.gz" \
        "https://sourceforge.net/projects/boost/files/boost/${BOOST_VERSION}/${BOOST_PACKAGE_NAME}.tar.gz/download"; do \
        if curl --fail --location --retry 5 --retry-all-errors \
          --connect-timeout 10 --speed-time 30 --speed-limit 1024 \
          -o "${boost_archive}" "${boost_url}"; then \
          break; \
        fi; \
        rm -f "${boost_archive}"; \
      done; \
    fi; \
    test -s "${boost_archive}"; \
    rm -rf /tmp/boost/*; \
    tar -xzf "${boost_archive}" -C /tmp/boost --strip-components=1

FROM toolchain AS libcedar

ARG TARGETARCH
ARG LIBCEDAR_VERSION
ARG LIBCEDAR_PKG_BASE_URL=https://github.com/lurkingryuu/libcedar/releases/download
ARG LIBCEDAR_PREFIX=/opt/libcedar

# LIBCEDAR_CACHE_BUST is intentionally opt-in and should only be used when
# explicitly forcing a re-download of the packaged SDK.
ARG LIBCEDAR_CACHE_BUST
RUN --mount=type=cache,target=/var/cache/asql-downloads/libcedar \
    set -eux; \
    libcedar_version="${LIBCEDAR_VERSION:?LIBCEDAR_VERSION build arg must be set}"; \
    target_arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "${target_arch}" in \
      amd64) libcedar_target="x86_64-unknown-linux-gnu" ;; \
      arm64) libcedar_target="aarch64-unknown-linux-gnu" ;; \
      *) echo "Unsupported TARGETARCH: ${target_arch}" >&2; exit 1 ;; \
    esac; \
    archive_name="libcedar-${libcedar_version#v}-${libcedar_target}.tar.gz"; \
    archive_path="/var/cache/asql-downloads/libcedar/${archive_name}"; \
    if [ ! -s "${archive_path}" ] || [ -n "${LIBCEDAR_CACHE_BUST}" ]; then \
      curl -fsSL -o "${archive_path}" \
        "${LIBCEDAR_PKG_BASE_URL}/${libcedar_version}/${archive_name}"; \
    fi; \
    mkdir -p "${LIBCEDAR_PREFIX}"; \
    tar -xzf "${archive_path}" -C "${LIBCEDAR_PREFIX}"; \
    libcedar_pc_dir=""; \
    for candidate in "${LIBCEDAR_PREFIX}/lib/pkgconfig" "${LIBCEDAR_PREFIX}"/lib/*/pkgconfig; do \
      if [ -f "${candidate}/libcedar.pc" ]; then libcedar_pc_dir="${candidate}"; break; fi; \
    done; \
    test -n "${libcedar_pc_dir}"; \
    ln -sfn "${libcedar_pc_dir}" "${LIBCEDAR_PREFIX}/lib/pkgconfig"

FROM toolchain AS builder-base

ARG LIBCEDAR_PREFIX=/opt/libcedar

ENV PKG_CONFIG_PATH="${LIBCEDAR_PREFIX}/lib/pkgconfig"
ENV CMAKE_PREFIX_PATH="${LIBCEDAR_PREFIX}"
ENV CCACHE_DIR=/var/cache/asql-ccache
ENV CCACHE_BASEDIR=/mysql-source
ENV CCACHE_COMPILERCHECK=content
ENV CCACHE_COMPRESS=1
ENV CCACHE_MAXSIZE=10G

COPY --from=boost /tmp/boost /tmp/boost
COPY --from=libcedar ${LIBCEDAR_PREFIX} ${LIBCEDAR_PREFIX}

RUN mkdir -p /mysql-build

WORKDIR /mysql-source

# Copy necessary files for build.
COPY CMakeLists.txt MYSQL_VERSION *.cmake *.in *.h.cmake README INSTALL LICENSE ./
COPY *.sh ./
COPY sql/ sql/
COPY include/ include/
COPY storage/ storage/
COPY cmake/ cmake/
COPY libmysql/ libmysql/
COPY mysys/ mysys/
COPY extra/ extra/
COPY strings/ strings/
COPY vio/ vio/
COPY components/ components/
COPY --exclude=authorization plugin/ plugin/
COPY share/ share/
COPY libservices/ libservices/
COPY libbinlogevents/ libbinlogevents/
COPY libbinlogstandalone/ libbinlogstandalone/
COPY libchangestreams/ libchangestreams/
COPY sql-common/ sql-common/
COPY utilities/ utilities/
COPY client/ client/
COPY router/ router/
COPY packaging/ packaging/
COPY man/ man/
COPY support-files/ support-files/
COPY testclients/ testclients/
COPY scripts/ scripts/
COPY mysql-test/ mysql-test/
COPY --exclude=gunit/authorization unittest/ unittest/
COPY doxygen_resources/ doxygen_resources/
COPY plugin/authorization/ plugin/authorization/
COPY unittest/gunit/authorization/ unittest/gunit/authorization/

RUN chmod +x \
    /mysql-source/unittest/docker/run-test-suite.sh \
    /mysql-source/test_integrated_plugins.sh \
    /mysql-source/unittest/docker/mock_cedar_sync_service.py

WORKDIR /mysql-build

ENTRYPOINT ["bash", "/mysql-source/unittest/docker/run-test-suite.sh"]
CMD ["full"]

FROM builder-base AS builder

# Build argument for parallel jobs (defaults to all available CPUs)
ARG PARALLEL_JOBS

WORKDIR /mysql-build

# Keep the full build tree and ccache in persistent BuildKit caches so small
# source edits only rebuild the affected objects and targets.
RUN --mount=type=cache,target=/var/cache/asql-build/unittest \
    --mount=type=cache,target=/var/cache/asql-ccache \
    set -eux; \
    build_cache_dir="/var/cache/asql-build/unittest"; \
    mkdir -p "${CCACHE_DIR}"; \
    ccache --zero-stats || true; \
    cmake -S /mysql-source -B "${build_cache_dir}" \
      -DCMAKE_BUILD_TYPE=RelWithDebInfo \
      -DCMAKE_INSTALL_PREFIX=/usr/local/mysql \
      -DDOWNLOAD_BOOST=0 \
      -DWITH_BOOST=/tmp/boost \
      -DWITH_UNIT_TESTS=ON \
      -DWITH_DEBUG=OFF \
      -DENABLED_LOCAL_INFILE=1 \
      -DMYSQL_DATADIR=/var/lib/mysql \
      -DSYSCONFDIR=/etc/mysql \
      -DWITH_SSL=system \
      -DCMAKE_C_COMPILER_LAUNCHER=ccache \
      -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
      -G Ninja; \
    if [ -n "${PARALLEL_JOBS}" ]; then \
      ninja -C "${build_cache_dir}" -j"${PARALLEL_JOBS}" \
        mysqld mysql ddl_audit embedded_cedar authorization-t embedded-cedar-t; \
    else \
      ninja -C "${build_cache_dir}" -j"$(nproc)" \
        mysqld mysql ddl_audit embedded_cedar authorization-t embedded-cedar-t; \
    fi; \
    ccache --show-stats || true; \
    rsync -a --delete "${build_cache_dir}/" /mysql-build/

FROM builder-base AS unittest-dev

ENV AUTO_BUILD=1

WORKDIR /mysql-build

ENTRYPOINT ["bash", "/mysql-source/unittest/docker/run-test-suite.sh"]
CMD ["full"]

FROM builder AS unittest
