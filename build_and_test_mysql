#!/bin/bash

set -e  # Exit immediately if a command fails

# take options
# --no-build: skip building MySQL
# --no-test: skip testing MySQL
# --no-clean: skip cleaning up MySQL installation


# Parse command line arguments
# Variables
NO_BUILD=0
NO_TEST=0
NO_CLEAN=0
PROFILE_NUM=0

while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
        --no-build)
            NO_BUILD=1
            shift
            ;;
        --no-test)
            NO_TEST=1
            shift
            ;;
        --no-clean)
            NO_CLEAN=1
            shift
            ;;
        --profile)
            PROFILE_NUM="$2"
            shift 2
            ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
done

# Variables
MYSQL_INSTALL_DIR="/usr/local/mysql"
MYSQL_BUILD_DIR="$HOME/mysql-server-ext/build"
MYSQL_DATA_DIR="$MYSQL_BUILD_DIR/data"
DEBUG_LOG="/tmp/mysql_debug_trace.log"
PROFILE_OUT_DIR="$HOME/mysql-server-ext/profile_out"
PROFILE_OUT="$PROFILE_OUT_DIR/profile_$PROFILE_NUM.tsv"

# Clean up MySQL installation
if [ "$NO_CLEAN" -eq 0 ]; then
    echo "### Stopping and Removing Any Previous MySQL Installation ###"
    if pgrep mysqld; then
        echo "Stopping MySQL service..."
        sudo pkill -9 mysqld
    fi

    # Remove previous data directory (if exists)
    if [ -d "$MYSQL_DATA_DIR" ]; then
        echo "Removing existing MySQL data directory: $MYSQL_DATA_DIR"
        sudo rm -rf "$MYSQL_DATA_DIR"
    fi

    # Remove previous debug log (if exists)
    if [ -f "$DEBUG_LOG" ]; then
        echo "Removing existing debug log: $DEBUG_LOG"
        sudo rm -f "$DEBUG_LOG"
    fi
fi


# Build MySQL
if [ "$NO_BUILD" -eq 0 ]; then

    # Remove previous MySQL installation (if exists)
    if [ -d "$MYSQL_INSTALL_DIR" ]; then
        echo "Removing existing MySQL installation: $MYSQL_INSTALL_DIR"
        sudo rm -rf "$MYSQL_INSTALL_DIR"
    fi

    echo "### Configuring and Building MySQL ###"
    mkdir -p "$MYSQL_BUILD_DIR"
    cd "$MYSQL_BUILD_DIR"

    cmake .. -DWITH_BOOST="$HOME/boost_1_73_0" \
        -DOPENSSL_ROOT_DIR=/usr/local/opt/openssl/ \
        -DOPENSSL_CRYPTO_LIBRARY=/usr/local/opt/openssl/lib/ \
        -DWITH_DEBUG=0 -DCMAKE_LINKER=lld

    num_cores=$(nproc)
    num_cores=$((num_cores - 6))
    echo "### Building MySQL with $num_cores cores ###"
    make -j"$num_cores"

    echo "### Installing MySQL ###"
    sudo make install

    echo "### MySQL Build Successful! ###"

    echo "### Setting up MySQL User and Permissions ###"
    if ! id "mysql" &>/dev/null; then
        sudo groupadd -f mysql
        sudo useradd -r -g mysql -s /bin/mysql
    fi

    sudo mkdir -p "$MYSQL_INSTALL_DIR/mysql-files"
    sudo chown -R mysql:mysql "$MYSQL_INSTALL_DIR/mysql-files"
fi

if [ "$NO_CLEAN" -eq 0 ]; then
    cd "$MYSQL_BUILD_DIR"
    
    # Re-check and remove any leftover MySQL data
    if [ -d "$MYSQL_DATA_DIR" ]; then
        echo "Cleaning up old MySQL data directory..."
        sudo rm -rf "$MYSQL_DATA_DIR"
    fi

    # Initialize MySQL
    echo "### Initializing MySQL Server ###"
    sudo bin/mysqld --initialize-insecure --user=mysql --datadir="$MYSQL_DATA_DIR"

    # Start MySQL Server with Debugging Enabled
    echo "### Starting MySQL Server with Debugging ###"
    # sudo bin/mysqld --debug=d:t:i:o,$DEBUG_LOG --user=mysql --datadir="$MYSQL_DATA_DIR" &
    sudo bin/mysqld --user=mysql --datadir="$MYSQL_DATA_DIR" --bind-address=0.0.0.0 &

    # Instructions to View Debug Logs
    echo "### To View Debug Logs, Run: ###"
    echo "less $DEBUG_LOG"
    echo "### To Filter Specific Debug Messages, Use: ###"
    echo "grep '<YourKeyword>' $DEBUG_LOG"


    sleep 5  # Allow MySQL to start
fi

if [ "$NO_TEST" -eq 1 ]; then
    echo "### Skipping MySQL Test ###"
    exit 0
fi

# Test MySQL connection
echo "### Running MySQL Test ###"
mysql -u root --skip-password -e "SELECT VERSION();" || { echo "MySQL test failed"; exit 1; }

echo "### MySQL Build and Test Successful! ###"
echo "### MySQL Server is Running! ###"


